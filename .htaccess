RewriteEngine On

# RewriteRule patterns below are relative to this directory, so they work
# whatever the URL prefix the application is installed under.

# Prevent access to sensitive directories and files
RewriteRule ^(storage|src|bin|docker|tests)(/|$) - [R=404,L]
RewriteRule (^|/)\. - [R=404,L]

# assets/ and vendor/: serve existing static files only. Anything else there
# (PHP scripts shipped by Composer packages, READMEs, missing files) is a 404.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(assets|vendor)/.+\.(css|js|mjs|map|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|ico)$ - [L]
RewriteRule ^(assets|vendor)(/|$) - [R=404,L]

# Redirect all other requests to index.php
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
    # Also applies to static files served directly by Apache
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
