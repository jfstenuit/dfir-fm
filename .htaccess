RewriteEngine On

# RewriteRule patterns below are relative to this directory, so they work
# whatever the URL prefix the application is installed under.

# Prevent access to sensitive directories and files
RewriteRule ^(storage|src|bin|docker|tests)(/|$) - [R=404,L]
RewriteRule (^|/)\. - [R=404,L]

# Static files: existing files under assets/ and the built front-end files of
# the three packages the pages load. Anything else there (PHP scripts, sources
# and build scripts shipped by Composer packages, READMEs, missing files) is a
# 404. tests/Support/router.php mirrors this.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(assets/|vendor/twbs/bootstrap/dist/|vendor/twbs/bootstrap-icons/font/|vendor/enyo/dropzone/dist/).+\.(css|js|mjs|map|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|ico)$ - [L]
RewriteRule ^(assets|vendor)(/|$) - [R=404,L]

# Redirect all other requests to index.php
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
    # Also applies to static files served directly by Apache
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
