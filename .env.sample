# Application Environment Configuration
# --------------------------------------
# Rename this file to `.env` and customize the values as needed.

# Mail Engine Configuration
# -------------------------
# Mail is used for invitation links. Check the configuration with
#   php bin/send-test-mail.php you@yourdomain.com
# (run it as the web server user). Send failures are logged as mail_send_failure.
#
# mail_engine: Specifies the mail engine to use. Supported values:
#   - mail      : The local sendmail binary (PHP's mail()), via PHPMailer (default)
#   - smtp      : An SMTP server, via PHPMailer
#   - sendgrid  : SendGrid's Web API v3
mail_engine=smtp

# SMTP Settings (mail_engine=smtp)
# --------------------------------
# smtp_host:     The SMTP server hostname (required)
# smtp_secure:   none (plain SMTP), starttls (TLS required after connecting)
#                or smtps (implicit TLS). Aliases: tls, ssl.
#                Default: none, except smtps when smtp_port=465.
#                With none, smtp_user/smtp_password travel in clear text:
#                use it only for a relay on a trusted network.
# smtp_port:     Default: 587 (starttls), 465 (smtps), 25 (none)
# smtp_user:     Leave empty for an unauthenticated relay
# smtp_password: Required when smtp_user is set
# smtp_timeout:  Connection timeout in seconds (default 30)
smtp_host=smtp.yourdomain.com
smtp_secure=starttls
smtp_port=587
smtp_user=your_smtp_username
smtp_password=your_smtp_password
#smtp_timeout=30

# SendGrid Settings (mail_engine=sendgrid)
# ----------------------------------------
# sendgrid_api_key: The API key for authenticating with SendGrid (required)
sendgrid_api_key=your_sendgrid_api_key

# Sender Information (all engines)
# --------------------------------
# default_mail_from: The "From" address, also used as envelope sender (required)
# default_mail_from_name: The display name (optional)
default_mail_from=no-reply@yourdomain.com
default_mail_from_name=DFIR-FM

# Storage Engine Configuration
# ----------------------------
# storage_engine: Specifies the storage engine to use. Supported values:
#   - local        : Use the local filesystem for storage
# Planned, not implemented yet (the application refuses to start with them):
#   - azure_blob   : Azure Blob Storage
#   - amazon_s3    : Amazon S3
storage_engine=local

# Local Storage Settings (Required if storage_engine=local)
# ---------------------------------------------------------
# base_storage_directory: The base directory for storing files locally.
# It must exist and must not be web-accessible.
base_storage_directory=/path/to/local/storage

# Uploads
# -------
# Uploads are assembled in the .uploads/ subdirectory of the storage, then
# hashed from storage and moved to their final place. The name .uploads is
# reserved in the root folder.
#
# upload_max_size: largest file accepted, in bytes; K, M, G, T suffixes
# (powers of 1024) are accepted, e.g. 200G. Empty: no limit.
#upload_max_size=
#
# upload_stale_after: seconds without activity after which an unfinished
# upload expires and its staged data is deleted (default 86400, one day).
# bin/expire-uploads.php does this from cron; uploads also trigger it.
#upload_stale_after=86400
#
# Uploads are sent in chunks of 2 MiB. PHP's upload_max_filesize and
# post_max_size, and any body size limit of the web server or a reverse
# proxy, must allow a bit more than that (e.g. 8M).

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------

# Trusted proxies
# trusted_proxies: comma-separated IPv4/IPv6 addresses or CIDR ranges of the
# reverse proxies allowed to report the client address in X-Forwarded-For.
#   - Empty (default): direct connections, or Apache mod_remoteip already
#     rewrites REMOTE_ADDR. X-Forwarded-For is ignored.
#   - Set: when the connecting address is in this list, the client is the
#     right-most X-Forwarded-For entry that is not itself a trusted proxy.
# Never list a range that includes untrusted hosts: anyone in it could forge
# their IP address (rate limiting, audit logs, uploaded_from).
# Examples:
#   Cloudflare Tunnel (cloudflared on the same host): 127.0.0.1, ::1
#   Reverse proxy on a Docker network:                172.16.0.0/12
trusted_proxies=

# force_https: set to true when the site is only reachable over HTTPS but PHP
# doesn't see it, e.g. TLS terminated by a reverse proxy in front of Apache
# with mod_remoteip (X-Forwarded-Proto is then not trusted). Session cookies
# get the Secure flag and generated links (invitation e-mails) use https://.
# Leave empty or false if the site is also served over plain HTTP: browsers
# would drop Secure cookies there and logins would fail.
force_https=

# Brute-force protection using APCu (the application refuses logins if APCu
# is missing). Attempts are counted per client IP and per username, within a
# window of login_lockout_duration seconds starting at the first attempt.
# Maximum login attempts per client IP
max_login_attempts=5

# Maximum login attempts per username, from any IP. Higher than the per-IP
# limit, because anyone can use it to lock a known username out for the
# window. A successful login resets it.
max_login_attempts_per_user=10

# Length of the counting window, in seconds
login_lockout_duration=300

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# log_engine: Supported values:
#   - file     : Plain text flat file (one event per line)
#   - syslog   : Send to system's local syslog
#   - stderr   : Output to STDERR (for containerized environments)
log_engine=file

# Path to log file (log_engine=file). Must be writable by the PHP user:
# the application refuses to serve requests if it isn't.
log_file_path=/var/log/dfir-fm.log

# Line format for log_engine=file: jsonl (default, one JSON object per line)
# or csv. Syslog and stderr always use JSON.
#log_format=jsonl

# Syslog identity (log_engine=syslog)
#syslog_tag=dfir-fm
